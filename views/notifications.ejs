<%- include('partials/head', { title: 'Reminders' }) %>
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3"><div><div class="section-label mb-1">Message center</div><h1>WhatsApp message center</h1></div><span class="text-muted"><i class="fab fa-whatsapp"></i> Click-to-chat enabled</span></div>
<div class="row g-4"><div class="col-md-6"><div class="card p-4 border-warning"><h4 class="text-warning"><i class="fas fa-clock"></i> 24-hour return reminders</h4><p class="text-muted small">Open WhatsApp with a pre-written reminder.</p><ul class="list-group list-group-flush bg-transparent"><% if (!upcoming.length) { %><li class="list-group-item bg-transparent text-muted">No upcoming returns tomorrow.</li><% } %><% upcoming.forEach(item => { %><li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center"><div><strong><%= item.customerName %></strong><br><small class="text-muted"><%= item.equipmentName %> (<%= item.phone %>)</small></div><a href="<%= item.link %>" target="_blank" rel="noopener" class="btn btn-sm btn-success"><i class="fab fa-whatsapp"></i> Send</a></li><% }) %></ul></div></div><div class="col-md-6"><div class="card p-4 border-danger"><h4 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Overdue alerts</h4><p class="text-muted small">Open WhatsApp with a pre-written alert.</p><ul class="list-group list-group-flush bg-transparent"><% if (!overdue.length) { %><li class="list-group-item bg-transparent text-muted">No overdue gear. Awesome!</li><% } %><% overdue.forEach(item => { %><li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center"><div><strong><%= item.customerName %></strong><br><small class="text-muted"><%= item.equipmentName %> | Due: <%= new Date(item.expectedReturn).toLocaleDateString('en', { month: 'short', day: 'numeric' }) %></small></div><a href="<%= item.link %>" target="_blank" rel="noopener" class="btn btn-sm btn-danger"><i class="fab fa-whatsapp"></i> Alert</a></li><% }) %></ul></div></div></div>
<%- include('partials/foot') %>
