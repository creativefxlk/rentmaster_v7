<%- include('partials/head', { title: 'Payments' }) %>
<div class="dashboard-intro d-flex justify-content-between align-items-end mb-4 pb-2"><div><div class="section-label mb-2">Finance desk</div><h1>Payment history</h1><p class="text-secondary mb-0">Track every checkout and return payment across your rentals.</p></div><div class="metric-icon d-none d-md-grid"><i class="fas fa-receipt"></i></div></div>
<div class="row g-3 mb-4"><% [['Total collected', summary.collected, 'success', 'Across all rentals'], ['Outstanding balance', summary.outstanding, 'warning', 'Still due from customers'], ['Rental accounts', summary.rentals, '', 'Payment accounts recorded']].forEach(metric => { %><div class="col-md-4"><div class="card metric-card p-4 h-100"><div class="section-label"><%= metric[0] %></div><div class="metric-value text-<%= metric[2] %> mt-3"><%= metric[0] === 'Rental accounts' ? metric[1] : 'LKR ' + Number(metric[1]).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></div><p class="text-secondary small mb-0"><%= metric[3] %></p></div></div><% }) %></div>
<div class="card p-3 p-md-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><div class="section-label mb-1">Transaction ledger</div><h4>All payments</h4></div><span class="badge bg-secondary"><%= payments.length %> transactions</span></div><div class="table-responsive"><table class="table table-dark table-hover align-middle"><thead><tr><th>Customer</th><th>Equipment</th><th>Payment</th><th>Amount</th><th>Rental total</th><th>Balance</th><th>Date</th></tr></thead><tbody><% if (!payments.length) { %><tr><td colspan="7" class="text-center text-muted py-4">No individual payment transactions recorded yet.</td></tr><% } %><% payments.forEach(payment => { const balance=Math.max(0,Number(payment.totalFee)-Number(payment.amountPaid)); %><tr><td><strong><%= payment.customerName %></strong><small class="d-block text-secondary"><%= payment.phone || '' %></small></td><td><%= payment.equipmentName %></td><td><span class="badge <%= payment.paymentType === 'return' ? 'bg-warning text-dark' : 'bg-info text-dark' %>"><%= payment.paymentType %></span></td><td class="text-success fw-semibold">LKR <%= Number(payment.amount).toFixed(2) %></td><td>LKR <%= Number(payment.totalFee).toFixed(2) %></td><td><%= balance > 0 ? 'LKR ' + balance.toFixed(2) : 'Paid in full' %></td><td class="text-secondary"><%= new Date(payment.paidAt).toLocaleString() %></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/foot') %>