<%- include('partials/head', { title: 'Dashboard' }) %>
<div class="dashboard-intro d-flex justify-content-between align-items-end mb-4 pb-2"><div><div class="section-label mb-2">Operations overview</div><h1 class="mb-1">Good to see you, <%= user.username %>.</h1><p class="text-secondary mb-0">Here is what is happening across your studio today.</p></div><div class="text-end"><div class="section-label">Today</div><div class="fw-semibold"><%= new Date().toLocaleDateString('en', { weekday: 'long', month: 'short', day: 'numeric' }) %></div></div></div>
<div class="row g-4 mb-4"><div class="col-md-4"><div class="card metric-card p-4 h-100"><div class="d-flex justify-content-between"><div class="section-label"><%= isAdmin ? 'Collected revenue' : 'Client base' %></div><div class="metric-icon"><i class="fas fa-chart-line"></i></div></div><div class="metric-value <%= isAdmin ? 'text-success' : 'text-info' %> mt-3"><%= isAdmin ? 'LKR ' + Number(revenue.totalPaid || 0).toLocaleString(undefined, { minimumFractionDigits: 2 }) : totalCustomers %></div><p class="text-secondary mb-0 small"><%= isAdmin ? 'LKR ' + Number(revenue.pending || 0).toLocaleString(undefined, { minimumFractionDigits: 2 }) + ' pending' : 'Registered customers' %></p></div></div><div class="col-md-4"><div class="card metric-card p-4 h-100"><div class="d-flex justify-content-between"><div class="section-label">Equipment in use</div><div class="metric-icon"><i class="fas fa-camera"></i></div></div><div class="metric-value mt-3"><%= outGear %> <span class="text-secondary fs-5 fw-normal">/ <%= totalGear %></span></div><p class="text-secondary mb-0 small">Currently rented out</p></div></div><div class="col-md-4"><div class="card p-4 h-100 d-flex flex-column justify-content-center"><div class="section-label mb-2">Quick action</div><a href="/equipment" class="btn btn-brand btn-lg mb-2"><i class="fas fa-video me-2"></i> Manage equipment</a><a href="/calendar" class="btn btn-outline-light"><i class="fas fa-calendar me-2"></i> Open schedule</a></div></div></div>
<div class="card p-3 p-md-4 mb-4"><div class="d-flex justify-content-between"><div><div class="section-label mb-1">Seven-day pulse</div><h4 class="mb-1">Rental activity</h4><p class="text-secondary small mb-0">New rentals created over the last seven days.</p></div><div class="metric-icon"><i class="fas fa-chart-column"></i></div></div><div class="activity-chart"><% weekActivity.forEach((day, index) => { %><div class="chart-column"><span class="chart-count"><%= day.count %></span><div class="chart-bar-wrap"><div class="chart-bar" style="height:<%= Math.max(6, day.count / maxActivity * 100) %>%;animation-delay:<%= index * 70 %>ms"></div></div><span class="chart-label"><%= day.label %></span></div><% }) %></div></div>
<div class="card p-3 p-md-4"><div class="d-flex justify-content-between align-items-center mb-2"><div><div class="section-label mb-1">Live activity</div><h4 class="mb-0">Active rentals</h4></div><a href="/equipment" class="btn btn-sm btn-outline-secondary">View equipment <i class="fas fa-arrow-right ms-1"></i></a></div><div class="table-responsive"><table class="table table-dark table-hover align-middle"><thead><tr><th>Equipment</th><th>Customer</th><th>Due Date</th><th>Status</th></tr></thead><tbody><% if (!activeRentals.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No active rentals.</td></tr><% } %><% activeRentals.forEach(rent => { %><tr><td><strong><%= rent.equipmentName %></strong></td><td><%= rent.customerName %></td><td><%= new Date(rent.expectedReturn).toLocaleString() %></td><td><span class="badge bg-primary">Active</span></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/foot') %>
