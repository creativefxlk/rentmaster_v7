<%- include('partials/head', { title: 'Equipment' }) %>
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3"><div><div class="section-label mb-1">Asset control</div><h1>Equipment inventory</h1></div><button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addModal"><i class="fas fa-plus me-2"></i> Add equipment</button></div>
<% if (error) { %><div class="alert alert-warning"><%= error %></div><% } %>
<div class="card p-4 mb-4"><div class="d-flex justify-content-between mb-3"><div><div class="section-label mb-1">Live checkouts</div><h4>Currently rented</h4></div><span class="badge bg-warning text-dark"><%= activeRentals.length %> out</span></div><div class="table-responsive"><table class="table table-dark table-hover align-middle"><thead><tr><th>Equipment</th><th>Customer</th><th>Due back</th><th>Days used / booked</th><th>Settles at</th><th class="text-end">Action</th></tr></thead><tbody><% if (!activeRentals.length) { %><tr><td colspan="6" class="text-center text-muted py-3">All equipment is currently available.</td></tr><% } %><% activeRentals.forEach(rental => { const early = rental.actualDays < rental.bookedDays; %><tr><td><strong><%= rental.equipmentName %></strong></td><td><%= rental.customerName %><% if (!rental.email) { %> <span class="badge bg-secondary" title="No email on file, no receipt will be sent">no email</span><% } %></td><td><%= new Date(rental.expectedReturn).toLocaleString() %></td><td><%= rental.actualDays %> / <%= rental.bookedDays %><% if (early) { %> <span class="badge bg-success">early</span><% } %></td><td><% if (rental.refundDue > 0) { %><span class="text-success">refund LKR <%= rental.refundDue.toFixed(2) %></span><% } else if (rental.balanceDue > 0) { %><span class="text-warning">collect LKR <%= rental.balanceDue.toFixed(2) %></span><% } else { %><span class="text-secondary">settled</span><% } %></td><td class="text-end"><button class="btn btn-sm btn-brand" data-bs-toggle="modal" data-bs-target="#ret<%= rental.id %>"><i class="fas fa-rotate-left"></i> Return</button></td></tr><% }) %></tbody></table></div></div>

<% activeRentals.forEach(rental => { const early = rental.actualDays < rental.bookedDays; const depositNet = Number(rental.deposit); %>
<div class="modal fade" id="ret<%= rental.id %>" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><form method="post">
  <input type="hidden" name="action" value="return"><input type="hidden" name="equipmentId" value="<%= rental.id %>">
  <div class="modal-header"><h5 class="mb-0">Return &mdash; <%= rental.equipmentName %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <% if (early) { %><div class="alert alert-success py-2"><i class="fas fa-circle-check me-1"></i> Returning <strong><%= rental.bookedDays - rental.actualDays %></strong> day(s) early &mdash; the charge is recalculated to <strong><%= rental.actualDays %></strong> day(s).</div><% } %>
    <div class="row g-3 mb-3">
      <div class="col-md-6"><table class="table table-sm table-dark mb-0">
        <tr><td class="text-secondary">Daily rate</td><td class="text-end">LKR <%= Number(rental.dailyPrice).toFixed(2) %></td></tr>
        <tr><td class="text-secondary">Days booked / used</td><td class="text-end"><%= rental.bookedDays %> / <%= rental.actualDays %></td></tr>
        <tr><td class="text-secondary">Agreed total</td><td class="text-end">LKR <%= Number(rental.totalFee).toFixed(2) %></td></tr>
        <tr><td class="text-secondary">Recalculated total</td><td class="text-end fw-bold">LKR <%= Number(rental.finalTotal).toFixed(2) %></td></tr>
        <tr><td class="text-secondary">Already paid</td><td class="text-end">LKR <%= Number(rental.amountPaid).toFixed(2) %></td></tr>
      </table></div>
      <div class="col-md-6">
        <% if (rental.refundDue > 0) { %>
          <div class="alert alert-success py-2 mb-2">Overpayment of <strong>LKR <%= rental.refundDue.toFixed(2) %></strong> will be refunded.</div>
        <% } %>
        <label class="form-label">Balance to collect now</label>
        <input name="returnPayment" type="number" min="0" max="<%= rental.balanceDue %>" step="0.01" value="<%= rental.balanceDue.toFixed(2) %>" class="form-control mb-2" <%= rental.balanceDue > 0 ? '' : 'readonly' %>>
        <label class="form-label">Received via</label>
        <select name="returnMethod" class="form-select mb-2"><option value="cash" selected>Cash</option><option value="bank_transfer">Bank transfer</option><option value="online">Online payment</option></select>
        <input name="returnReference" class="form-control" maxlength="120" placeholder="Reference number (bank/online) or note">
      </div>
    </div>
    <hr class="border-secondary">
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label">Deposit held</label><input class="form-control" value="LKR <%= depositNet.toFixed(2) %>" readonly tabindex="-1"></div>
      <div class="col-md-4"><label class="form-label">Deduct from deposit</label><input name="depositDeduction" type="number" min="0" max="<%= depositNet %>" step="0.01" value="0.00" class="form-control"></div>
      <div class="col-md-4"><label class="form-label">Reason for deduction</label><input name="depositDeductionReason" class="form-control" maxlength="255" placeholder="e.g. lens hood scratch"></div>
    </div>
    <div class="form-text mt-2">Leave the deduction at 0.00 to refund the full deposit.<% if (rental.email) { %> A final receipt will be emailed to <%= rental.email %>.<% } else { %> No email on file &mdash; no receipt will be sent.<% } %></div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-brand"><i class="fas fa-rotate-left"></i> Complete return</button></div>
</form></div></div></div>
<% }) %>
<div class="card p-4"><div class="table-responsive"><table class="table table-dark table-hover"><thead><tr><th>Asset ID</th><th>Gear Name</th><th>Category</th><th>Daily price</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><% equipment.forEach(item => { %><tr><td>EQ-<%= String(item.id).padStart(4, '0') %></td><td><strong><%= item.name %></strong></td><td><%= item.type %></td><td>LKR <%= Number(item.daily_price).toFixed(2) %></td><td><span class="badge <%= item.status === 'Available' ? 'bg-success' : item.status === 'Rented' ? 'bg-warning text-dark' : 'bg-danger' %>"><%= item.status %></span></td><td class="text-end"><button class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#edit<%= item.id %>"><i class="fas fa-pen"></i></button><% if (isAdmin) { %><form method="post" class="d-inline"><input type="hidden" name="action" value="delete"><input type="hidden" name="equipmentId" value="<%= item.id %>"><button class="btn btn-sm btn-outline-danger" <%= item.status === 'Rented' ? 'disabled' : '' %>><i class="fas fa-trash"></i></button></form><% } %></td></tr><% }) %></tbody></table></div></div>
<div class="modal fade" id="addModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post"><div class="modal-header"><h5>Add equipment</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="action" value="add"><div class="mb-3"><label class="form-label">Equipment name</label><input name="name" class="form-control" required></div><div class="mb-3"><label class="form-label">Category</label><input name="type" class="form-control" required></div><div class="mb-3"><label class="form-label">Daily price (LKR)</label><input name="dailyPrice" type="number" min="0" step=".01" class="form-control" required></div><label class="form-label">Status</label><select name="status" class="form-select"><option>Available</option><option>Maintenance</option></select></div><div class="modal-footer"><button class="btn btn-brand w-100">Add equipment</button></div></form></div></div></div>
<% equipment.forEach(item => { %><div class="modal fade" id="edit<%= item.id %>" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post"><div class="modal-header"><h5>Edit equipment</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="action" value="update"><input type="hidden" name="equipmentId" value="<%= item.id %>"><div class="mb-3"><label class="form-label">Equipment name</label><input name="name" class="form-control" value="<%= item.name %>" required></div><div class="mb-3"><label class="form-label">Category</label><input name="type" class="form-control" value="<%= item.type %>" required></div><div class="mb-3"><label class="form-label">Daily price (LKR)</label><input name="dailyPrice" type="number" min="0" step=".01" class="form-control" value="<%= item.daily_price %>" required></div><label class="form-label">Status</label><select name="status" class="form-select"><option <%= item.status === 'Available' ? 'selected' : '' %>>Available</option><option <%= item.status === 'Maintenance' ? 'selected' : '' %>>Maintenance</option><option <%= item.status === 'Rented' ? 'selected' : '' %>>Rented</option></select></div><div class="modal-footer"><button class="btn btn-brand w-100">Save changes</button></div></form></div></div></div><% }) %>
<%- include('partials/foot') %>
