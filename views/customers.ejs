<%- include('partials/head', { title: 'Customers' }) %>
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3"><div><div class="section-label mb-1">People and records</div><h1>Client database</h1></div></div>
<div class="card p-4"><div class="table-responsive"><table class="table table-dark table-striped align-middle"><thead><tr><th>ID</th><th>ID Document</th><th>Name</th><th>NIC Number</th><th>Phone</th></tr></thead><tbody><% if (!customers.length) { %><tr><td colspan="5" class="text-center text-muted py-3">No customers found.</td></tr><% } %><% customers.forEach(customer => { const documentUrl = customer.id_image && customer.id_image.startsWith('http') ? customer.id_image : `/uploads/${String(customer.id_image || '').replace(/^uploads\//, '')}`; %><tr><td>#<%= customer.id %></td><td><% if (customer.id_image) { %><a href="<%= documentUrl %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i> View</a><% } else { %><span class="text-muted small">No File</span><% } %></td><td><strong><%= customer.name %></strong></td><td><%= customer.nic %></td><td><%= customer.phone || '' %></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/foot') %>
