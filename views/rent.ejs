<%- include('partials/head', { title: 'New Rental' }) %>
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3"><div><div class="section-label mb-1">Checkout desk</div><h1>New rental processing</h1></div></div>
<% if (success) { %><div class="alert alert-success d-flex justify-content-between align-items-center gap-3 flex-wrap"><span><%= success %></span><a href="<%= whatsappLink %>" target="_blank" rel="noopener" class="btn btn-success"><i class="fab fa-whatsapp me-1"></i> Send WhatsApp reminder</a></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="card p-4 mx-auto" style="max-width:1000px"><form method="post" action="/rent" enctype="multipart/form-data" class="row g-4" onsubmit="return saveSignature()"><div class="col-md-4 border-end border-secondary"><h5 class="mb-3 text-brand"><i class="fas fa-id-card"></i> 1. Client identity</h5><div class="mb-3"><label class="form-label">National ID (NIC) *</label><input name="nic" class="form-control" required></div><div class="mb-3"><label class="form-label">Full name *</label><input name="customerName" class="form-control" required></div><div class="mb-3"><label class="form-label">Phone number (WhatsApp) *</label><input name="phone" class="form-control" placeholder="e.g. 077xxxxxxx" required></div><div class="mb-3"><label class="form-label">Email address</label><input type="email" name="email" class="form-control" placeholder="client@example.com"><div class="form-text">Receipts are emailed here. Leave blank to skip.</div></div><div class="mb-3"><label class="form-label">Upload NIC/passport photo</label><input type="file" name="nicImage" class="form-control bg-dark text-light" accept="image/*"></div></div><div class="col-md-4 border-end border-secondary"><h5 class="mb-3 text-brand"><i class="fas fa-camera"></i> 2. Gear & pricing</h5><div class="mb-3"><label class="form-label">Select equipment *</label><select name="equipmentId" id="equipmentId" class="form-select" required><option value="">-- Choose available gear --</option><% equipment.forEach(item => { %><option value="<%= item.id %>" data-price="<%= item.daily_price %>"><%= item.name %> (<%= item.type %>)</option><% }) %></select></div><div class="mb-3"><label class="form-label">Daily price (LKR)</label><input type="text" id="dailyPrice" class="form-control-plaintext px-2 rounded border border-secondary bg-dark text-light" value="—" readonly tabindex="-1"></div><div class="mb-3"><label class="form-label">Pickup time *</label><input type="datetime-local" name="startDate" id="startDate" class="form-control" required></div><div class="mb-3"><label class="form-label">Return time *</label><input type="datetime-local" name="endDate" id="endDate" class="form-control" required></div><div class="mb-3"><label class="form-label">Rental days</label><input type="text" id="rentalDays" class="form-control-plaintext px-2 rounded border border-secondary bg-dark text-light" value="—" readonly tabindex="-1"></div><div class="row"><div class="col-6 mb-3"><label class="form-label">Total fee *</label><input type="number" step=".01" min="0" name="totalFee" id="totalFee" class="form-control" required><div class="form-text">Daily price × rental days.</div></div><div class="col-6 mb-3"><label class="form-label">Refundable deposit *</label><input type="number" step=".01" min="0" name="deposit" id="deposit" class="form-control" value="5000.00" required><div class="form-text">Returned to the client on gear return.</div></div></div><div class="row"><div class="col-6 mb-3"><label class="form-label">Advance payment *</label><input type="number" step=".01" min="0" name="amountPaid" id="amountPaid" class="form-control" value="0.00" required></div><div class="col-6 mb-3"><label class="form-label">Received via *</label><select name="paymentMethod" id="paymentMethod" class="form-select" required><option value="cash" selected>Cash</option><option value="bank_transfer">Bank transfer</option><option value="online">Online payment</option></select></div></div><div class="mb-3"><label class="form-label" id="referenceLabel" for="paymentReference">Cash note</label><input name="paymentReference" id="paymentReference" class="form-control" maxlength="120" placeholder="e.g. counter receipt no."><div class="form-text" id="referenceHelp">Optional short comment for cash.</div></div></div><div class="col-md-4"><h5 class="mb-3 text-brand"><i class="fas fa-file-signature"></i> 3. Authorization</h5><p class="text-muted small">Please sign inside the box below to authorize this equipment rental agreement.</p><div class="signature-wrapper mb-2"><canvas id="signature-pad" class="signature-pad"></canvas></div><button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="signaturePad.clear()">Clear signature</button><input type="hidden" name="signature" id="signature"></div><div class="col-12 mt-4 text-end border-top border-secondary pt-3"><button class="btn btn-brand btn-lg px-5"><i class="fas fa-check-circle"></i> Complete rental checkout</button></div></form></div>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script><script>const canvas=document.getElementById('signature-pad');function resizeCanvas(){const ratio=Math.max(window.devicePixelRatio||1,1);canvas.width=canvas.offsetWidth*ratio;canvas.height=canvas.offsetHeight*ratio;canvas.getContext('2d').scale(ratio,ratio)}window.onresize=resizeCanvas;resizeCanvas();const signaturePad=new SignaturePad(canvas,{penColor:'rgb(255,255,255)',backgroundColor:'rgb(26,26,26)'});const gear=document.getElementById('equipmentId'),startField=document.getElementById('startDate'),endField=document.getElementById('endDate');const dailyPriceField=document.getElementById('dailyPrice'),rentalDaysField=document.getElementById('rentalDays'),totalFeeField=document.getElementById('totalFee');const methodField=document.getElementById('paymentMethod'),advanceField=document.getElementById('amountPaid');const refField=document.getElementById('paymentReference'),refLabel=document.getElementById('referenceLabel'),refHelp=document.getElementById('referenceHelp');function dailyPrice(){return Number(gear.options[gear.selectedIndex]?.dataset.price||0)}function rentalDays(){const start=new Date(startField.value),end=new Date(endField.value);if(isNaN(start)||isNaN(end)||end<=start)return 0;return Math.max(1,Math.ceil((end-start)/86400000))}function updateFee(){const price=dailyPrice(),days=rentalDays();dailyPriceField.value=price?price.toFixed(2):'\u2014';rentalDaysField.value=days?days+(days===1?' day':' days'):'\u2014';if(price&&days)totalFeeField.value=(price*days).toFixed(2)}function updateReference(){const needsRef=methodField.value!=='cash'&&Number(advanceField.value)>0;refField.required=needsRef;refLabel.textContent=needsRef?'Transfer reference number *':'Cash note';refHelp.textContent=needsRef?'Required for bank and online payments.':'Optional short comment for cash.';refField.placeholder=needsRef?'e.g. TRF8891234':'e.g. counter receipt no.'}[gear,startField,endField].forEach(el=>el.addEventListener('change',updateFee));[methodField,advanceField].forEach(el=>el.addEventListener('change',updateReference));advanceField.addEventListener('input',updateReference);updateFee();updateReference();function saveSignature(){if(signaturePad.isEmpty()){alert('Please provide a signature first.');return false}document.getElementById('signature').value=signaturePad.toDataURL();return true}</script>
<%- include('partials/foot') %>