<%- include('partials/head', { title: 'New Rental' }) %>
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3"><div><div class="section-label mb-1">Checkout desk</div><h1>New rental processing</h1></div></div>
<% if (success) { %><div class="alert alert-success d-flex justify-content-between align-items-center gap-3 flex-wrap"><span><%= success %></span><a href="<%= whatsappLink %>" target="_blank" rel="noopener" class="btn btn-success"><i class="fab fa-whatsapp me-1"></i> Send WhatsApp reminder</a></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="card p-4 mx-auto" style="max-width:1000px"><form method="post" action="/rent" enctype="multipart/form-data" class="row g-4" onsubmit="return saveSignature()"><div class="col-md-4 border-end border-secondary"><h5 class="mb-3 text-brand"><i class="fas fa-id-card"></i> 1. Client identity</h5><div class="mb-3"><label class="form-label">National ID (NIC) *</label><input name="nic" class="form-control" required></div><div class="mb-3"><label class="form-label">Full name *</label><input name="customerName" class="form-control" required></div><div class="mb-3"><label class="form-label">Phone number (WhatsApp) *</label><input name="phone" class="form-control" placeholder="e.g. 077xxxxxxx" required></div><div class="mb-3"><label class="form-label">Upload NIC/passport photo</label><input type="file" name="nicImage" class="form-control bg-dark text-light" accept="image/*"></div></div><div class="col-md-4 border-end border-secondary"><h5 class="mb-3 text-brand"><i class="fas fa-camera"></i> 2. Gear & pricing</h5><div class="mb-3"><label class="form-label">Select equipment *</label><select name="equipmentId" class="form-select" required><option value="">-- Choose available gear --</option><% equipment.forEach(item => { %><option value="<%= item.id %>" data-price="<%= item.daily_price %>"><%= item.name %> (<%= item.type %> - LKR <%= Number(item.daily_price).toFixed(2) %>/day)</option><% }) %></select></div><div class="mb-3"><label class="form-label">Pickup time *</label><input type="datetime-local" name="startDate" id="startDate" class="form-control" required></div><div class="mb-3"><label class="form-label">Return time *</label><input type="datetime-local" name="endDate" id="endDate" class="form-control" required></div><div class="row"><div class="col-6 mb-3"><label class="form-label">Total fee *</label><input type="number" step=".01" name="totalFee" id="totalFee" class="form-control" required></div><div class="col-6 mb-3"><label class="form-label">Paid *</label><input type="number" step=".01" name="amountPaid" class="form-control" value="0.00" required></div></div></div><div class="col-md-4"><h5 class="mb-3 text-brand"><i class="fas fa-file-signature"></i> 3. Authorization</h5><p class="text-muted small">Please sign inside the box below to authorize this equipment rental agreement.</p><div class="signature-wrapper mb-2"><canvas id="signature-pad" class="signature-pad"></canvas></div><button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="signaturePad.clear()">Clear signature</button><input type="hidden" name="signature" id="signature"></div><div class="col-12 mt-4 text-end border-top border-secondary pt-3"><button class="btn btn-brand btn-lg px-5"><i class="fas fa-check-circle"></i> Complete rental checkout</button></div></form></div>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script><script>const canvas=document.getElementById('signature-pad');function resizeCanvas(){const ratio=Math.max(window.devicePixelRatio||1,1);canvas.width=canvas.offsetWidth*ratio;canvas.height=canvas.offsetHeight*ratio;canvas.getContext('2d').scale(ratio,ratio)}window.onresize=resizeCanvas;resizeCanvas();const signaturePad=new SignaturePad(canvas,{penColor:'rgb(255,255,255)',backgroundColor:'rgb(26,26,26)'});const select=document.querySelector('select[name="equipmentId"]');function updateFee(){const price=Number(select.options[select.selectedIndex]?.dataset.price||0),start=new Date(document.getElementById('startDate').value),end=new Date(document.getElementById('endDate').value);if(price&&start<end)document.getElementById('totalFee').value=(price*Math.max(1,Math.ceil((end-start)/86400000))).toFixed(2)}select.addEventListener('change',updateFee);startDate.addEventListener('change',updateFee);endDate.addEventListener('change',updateFee);function saveSignature(){if(signaturePad.isEmpty()){alert('Please provide a signature first.');return false}document.getElementById('signature').value=signaturePad.toDataURL();return true}</script>
<%- include('partials/foot') %>